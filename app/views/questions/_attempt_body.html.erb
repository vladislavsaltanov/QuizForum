<% if attempt.question.choice? %>
  <ul class="qf-picked">
    <% attempt.selected.each do |i| %>
      <% opt = attempt.question.options[i.to_i] %>
      <% next if opt.nil? %>
      <li><%= opt["text"] %></li>
    <% end %>
  </ul>
<% else %>
  <% if attempt.language.present? %>
    <p class="qf-lang"><%= attempt.language %></p>
  <% end %>
  <div class="qf-body<%= ' qf-code' if attempt.language.present? %>"><%= literal_or_prose(attempt.language.present?, attempt.body) %></div>
<% end %>
