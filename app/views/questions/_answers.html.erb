<% if @question.open? %>
  <p class="qf-count">Всего ответов: <%= @question.attempts.size %></p>

  <% if @is_author %>
    <% if @attempts.empty? %>
      <p class="qf-empty">Пока никто не ответил.</p>
    <% end %>
    <%= render "summary", attempts: @attempts %>
    <details class="qf-answers-details">
      <summary class="qf-section-title">Все ответы · <%= @attempts.size %></summary>
    <div class="qf-chat">
    <% @attempts.each do |attempt| %>
      <div class="qf-attempt">
        <div class="qf-attempt-head">
          <span class="qf-attempt-who"><%= avatar_tag(attempt.user.name, size: :sm) %><%= attempt.user.name %></span>
          <span class="qf-chip <%= verdict_class(attempt.verdict) %>"><%= verdict_label(attempt.verdict) %></span>
        </div>
        <span class="qf-hint qf-answered-at">Ответ дан: <%= local_time_tag(attempt.created_at) %></span>
        <%= render "attempt_body", attempt: attempt %>
        <%= render "jury_block", attempt: attempt %>
      </div>
    <% end %>
    </div>
    </details>
  <% elsif @my_attempt %>
    <div class="qf-attempt">
      <div class="qf-attempt-head">
        <span>Ваш ответ</span>
        <span class="qf-chip" id="<%= dom_id(@my_attempt, :my_verdict) %>"><%= verdict_label("pending") %></span>
      </div>
      <%= render "attempt_body", attempt: @my_attempt %>
    </div>
    <p class="qf-hint">Ответ отправлен, изменить его нельзя.</p>
    <% if @respondent_names.any? %>
      <p class="qf-hint">Также ответили: <%= @respondent_names.join(", ") %></p>
    <% end %>
  <% else %>
    <%= form_with url: question_attempts_path(@question), class: "qf-form", data: { turbo_frame: "_top" } do |f| %>
      <% case @question.answer_type %>
      <% when "text" %>
        <%= text_area_tag "attempt[body]", nil, rows: 10, placeholder: "Ваш ответ…", class: "qf-input qf-answer-area", "aria-label": "Ответ" %>
      <% when "code" %>
        <% allowed_languages = @question.code_languages.presence || Attempt::LANGUAGES %>
        <%= select_tag "attempt[language]", options_for_select(allowed_languages), class: "qf-input", "aria-label": "Язык" %>
        <%= text_area_tag "attempt[body]", nil, rows: 12, placeholder: "Ваш код…", class: "qf-input qf-code qf-answer-area", "aria-label": "Код" %>
        <p class="qf-hint">Метод должен называться <code>solve</code>, число аргументов — как в примере выше.</p>
      <% when "single_choice" %>
        <% @question.options.each_with_index do |opt, i| %>
          <label class="qf-option">
            <%= radio_button_tag "attempt[selected][]", i, false, required: true %>
            <span><%= opt["text"] %></span>
          </label>
        <% end %>
      <% when "multiple_choice" %>
        <% @question.options.each_with_index do |opt, i| %>
          <label class="qf-option">
            <%= check_box_tag "attempt[selected][]", i %>
            <span><%= opt["text"] %></span>
          </label>
        <% end %>
      <% end %>
      <div class="qf-actions">
        <button type="submit" class="qf-apply">Отправить</button>
        <button type="button" class="qf-ghost" data-controller="share" data-action="click->share#copy">Поделиться</button>
      </div>
    <% end %>
    <% if @respondent_names.any? %>
      <p class="qf-hint">Уже ответили: <%= @respondent_names.join(", ") %></p>
    <% end %>
  <% end %>
<% else %>
  <%= render "stats", stats: @stats %>

  <% if @my_attempt %>
    <h2 class="qf-section-title">Ваш ответ · <%= render "attempts/chip", attempt: @my_attempt, prefix: :my_verdict %></h2>
    <div class="qf-attempt"><%= render "attempt_body", attempt: @my_attempt %></div>
    <%= render "jury_block", attempt: @my_attempt %>
  <% end %>

  <% unless @question.choice? %>
    <h2 class="qf-section-title">Ответ автора</h2>
    <div class="qf-body qf-reference"><%= simple_format(@question.reference_answer) %></div>
  <% else %>
    <h2 class="qf-section-title">Правильные варианты</h2>
    <div class="qf-body">
    <ul class="qf-picked">
      <% @question.options.each do |opt| %>
        <% if opt["correct"] %><li><%= opt["text"] %></li><% end %>
      <% end %>
    </ul>
    </div>
  <% end %>
  <% if @question.explanation.present? %>
    <h2 class="qf-section-title">Объяснение</h2>
    <div class="qf-body"><%= simple_format(@question.explanation) %></div>
  <% end %>

  <%= render "summary", attempts: @attempts %>
  <details class="qf-answers-details">
    <summary class="qf-section-title">Все ответы · <%= @attempts.size %></summary>
  <div class="qf-chat">
  <% @attempts.each do |attempt| %>
    <div class="qf-attempt">
      <div class="qf-attempt-head">
        <span class="qf-attempt-who"><%= avatar_tag(attempt.user.name, size: :sm) %><%= attempt.user.name %></span>
        <%= render "attempts/chip", attempt: attempt, prefix: :verdict %>
      </div>
      <% if @is_author %>
        <span class="qf-hint qf-answered-at">Ответ дан: <%= local_time_tag(attempt.created_at) %></span>
      <% end %>
      <%= render "attempt_body", attempt: attempt %>
      <%= render "jury_block", attempt: attempt %>
    </div>
  <% end %>
  </div>
  </details>

  <div class="qf-actions">
    <%= button_to "Пожаловаться", question_reports_path(@question), class: "qf-ghost", form: { data: { turbo_frame: "_top" } } %>
    <button type="button" class="qf-ghost" data-controller="share" data-action="click->share#copy">Поделиться</button>
  </div>
<% end %>
