<% content_for :title, @question.title %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: nil %>

<main class="qf-main qf-main-wide">
  <%= link_to "← Все вопросы", root_path, class: "qf-back" %>
  <% if @can_edit %>
    <div class="qf-actions">
      <%= link_to "Редактировать", edit_question_path(@question), class: "qf-ghost" %>
      <%= button_to "Удалить", question_path(@question), method: :delete, class: "qf-ghost", form: { data: { turbo_confirm: "Удалить вопрос со всеми ответами?" } } %>
      <% if @question.code? %>
        <%= button_to "Перепроверить код", recheck_question_path(@question), method: :post, class: "qf-ghost", form: { data: { turbo_confirm: "Перезапустить проверку ожидающих ответов?" } } %>
      <% end %>
    </div>
  <% end %>
  <p class="qf-kicker">
    <% if @question.open? %>
      До дедлайна · <%= time_left(@question.deadline) %>
    <% else %>
      Завершён <%= local_time_tag(@question.deadline) %>
    <% end %>
    · <%= @question.tags.map { "##{it}" }.join(" ") %>
  </p>
  <h1 class="qf-qtitle"><%= question_title_with_date(@question) %></h1>

  <div class="qf-panes">
    <section class="qf-pane" aria-label="Детали вопроса">
      <div class="qf-card qf-author-card">
        <%= avatar_tag(@question.author.name) %>
        <span class="qf-author-meta">
          <b><%= @question.author.name %></b>
          <% if @question.author.display_role.present? %>
            <i><%= @question.author.display_role %></i>
          <% end %>
        </span>
        <span class="qf-card-attempts">ответили: <%= @question.attempts.size %></span>
        <span class="qf-chip">до <%= local_time_tag(@question.deadline) %></span>
      </div>

      <h2 class="qf-section-title">Описание</h2>
      <div class="qf-body"><%= simple_format(@question.body) %></div>

      <% if @question.code? && (@question.example_input.present? || @question.example_output.present?) %>
        <h2 class="qf-section-title">Пример</h2>
        <div class="qf-body qf-code"><% if @question.example_input.present? %>Вход:
<%= @question.example_input %><% end %><% if @question.example_output.present? %>

Выход:
<%= @question.example_output %><% end %></div>
      <% end %>

      <% if @question.open? && @is_author %>
        <% unless @question.choice? %>
          <h2 class="qf-section-title">Ответ автора</h2>
          <div class="qf-body qf-reference"><%= literal_or_prose(@question.code?, @question.reference_answer) %></div>
        <% end %>
        <% if @question.explanation.present? %>
          <h2 class="qf-section-title">Объяснение</h2>
          <div class="qf-body"><%= simple_format(@question.explanation) %></div>
        <% end %>
      <% end %>
    </section>

    <section class="qf-pane<%= " is-comments" if @tab == "comments" %>" aria-label="Ответы и комментарии">
      <div class="qf-list-head">
        <div class="qf-tabs" role="tablist">
          <%= link_to "Ответы", question_path(@question), class: "qf-tab#{' is-active' if @tab == 'answers'}", role: "tab" %>
          <%= link_to "Комментарии", question_path(@question, tab: "comments"), class: "qf-tab#{' is-active' if @tab == 'comments'}", role: "tab" %>
        </div>
        <% unless @tab == "answers" %>
          <p class="qf-count">Обсуждение · <%= @comments_total %></p>
        <% end %>
      </div>

      <% if @tab == "answers" %>
        <%= turbo_stream_from @question %>
        <%= turbo_frame_tag "question-answers", data: { controller: "reveal", reveal_deadline_value: @question.deadline.iso8601, reveal_url_value: question_path(@question) } do %>
          <%= render "answers" %>
        <% end %>
      <% else %>
        <%= turbo_stream_from @question %>
        <div id="comments" class="qf-chat">
          <%= render "comments/more_marker", before: @comments.first&.id, url: question_comments_path(@question) if @has_older %>
          <% if @comments.empty? %>
            <p class="qf-empty">Пока тихо — начните обсуждение первым.</p>
          <% end %>
          <%= render @comments %>
        </div>
        <%= form_with url: question_comments_path(@question), class: "qf-chatbar" do |f| %>
          <%= text_area_tag "comment[body]", nil, rows: 1, placeholder: "Написать сообщение…", class: "qf-chat-input", "aria-label": "Новый комментарий", data: { controller: "composer", action: "keydown->composer#send" } %>
          <button type="submit" class="qf-send" aria-label="Отправить" data-turbo-submits-with="…">↑</button>
        <% end %>
        <p class="qf-hint">Сообщения проходят модерацию и открываются всем после дедлайна.</p>
        <script>
          {
            const qfChat = document.getElementById("comments");
            if (qfChat) {
              // Before the reader scrolls anything, every late re-layout (fonts,
              // load) must still land on the newest message. After that, follow
              // only while they are parked at the bottom, so a late callback can
              // never yank them back down mid-read.
              let qfReaderMoved = false;
              const qfBottom = () => {
                const atBottom = qfChat.scrollHeight - qfChat.scrollTop - qfChat.clientHeight < 24;
                if (!qfReaderMoved || atBottom) qfChat.scrollTo({ top: qfChat.scrollHeight });
              };
              qfBottom();
              requestAnimationFrame(qfBottom);
              window.addEventListener("load", qfBottom);
              if (document.fonts && document.fonts.ready) { document.fonts.ready.then(qfBottom); }
              new MutationObserver(qfBottom).observe(qfChat, { childList: true });
              const qfPane = qfChat.closest("section");
              // Cap the chat column at the room actually left below it, so the
              // composer is on screen when the page opens and never needs to be
              // sticky (a sticky one rides up and covers the newest bubble).
              const qfFit = () => {
                const qfRoom = window.innerHeight - qfPane.getBoundingClientRect().top - 28;
                qfPane.style.maxBlockSize = Math.max(220, qfRoom) + "px";
                qfBottom(); /* the pane just got shorter: re-pin the newest message */
              };
              qfFit();
              requestAnimationFrame(qfFit);
              window.addEventListener("resize", qfFit);
              const qfFade = () => qfPane.classList.toggle("is-scrolled", qfChat.scrollTop > 8);
              qfChat.addEventListener("scroll", qfFade, { passive: true });
              qfFade();
              // Reaching the top asks for the next 10 older comments; the
              // scroll offset is restored so the reader stays on the same bubble.
              let qfBusy = false;
              const qfLoadOlder = async () => {
                const qfMore = qfChat.querySelector("#comments-more");
                if (qfBusy || !qfMore) return;
                qfBusy = true;
                const prevHeight = qfChat.scrollHeight, prevTop = qfChat.scrollTop;
                try {
                  const qfRes = await fetch(`${qfMore.dataset.url}?before=${qfMore.dataset.before}`,
                    { headers: { Accept: "text/vnd.turbo-stream.html" } });
                  if (qfRes.ok) Turbo.renderStreamMessage(await qfRes.text());
                } finally {
                  qfBusy = false;
                }
                // Turbo applies a stream asynchronously, so wait for the prepended
                // rows to be laid out before pinning the reader back to the same
                // bubble. Restoring earlier reads a stale height and lurches.
                let tries = 0;
                const qfPin = () => {
                  const grown = qfChat.scrollHeight - prevHeight;
                  if (grown === 0 && tries++ < 20) { requestAnimationFrame(qfPin); return; }
                  qfReaderMoved = true;
                  qfChat.scrollTop = prevTop + grown;
                };
                requestAnimationFrame(qfPin);
              };
              qfChat.addEventListener("scroll", () => {
                if (qfChat.scrollTop > 8) qfReaderMoved = true;
                if (qfChat.scrollTop < 40) qfLoadOlder();
              }, { passive: true });
              const qfInput = qfPane.querySelector(".qf-chat-input");
              if (qfInput) { qfInput.addEventListener("focus", () => setTimeout(qfBottom, 300)); }
              if (window.visualViewport) { window.visualViewport.addEventListener("resize", qfBottom); }
            }
          }
        </script>
      <% end %>
    </section>
  </div>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span><%= @question.open? ? "Открыт" : "Завершён" %></span>
  </footer>
</main>
