<% content_for :title, "Новый вопрос" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: "mine" %>

<main class="qf-main">
  <p class="qf-kicker">Публикация</p>
  <h1 class="qf-hero">Новый вопрос</h1>

  <%= form_with model: @question, class: "qf-form" do |f| %>
    <% if @question.errors.any? %>
      <div class="qf-alert" role="alert"><%= @question.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= f.label :title, "Заголовок", class: "qf-label" %>
    <%= f.text_field :title, required: true, class: "qf-input", placeholder: "О чём спрашиваете?" %>

    <%= f.label :body, "Описание", class: "qf-label" %>
    <%= f.text_area :body, rows: 5, required: true, class: "qf-input", placeholder: "Условие, контекст, примеры…" %>

    <%= f.label :answer_type, "Тип ответа", class: "qf-label" %>
    <%= f.select :answer_type, [[ "Свободный текст", "text" ], [ "Код", "code" ], [ "Один вариант", "single_choice" ], [ "Несколько вариантов", "multiple_choice" ]], {}, class: "qf-filter", id: "question_answer_type" %>

    <fieldset id="qf-options">
      <legend class="qf-label">Варианты (только для типов с выбором)</legend>
      <% 6.times do |i| %>
        <div class="qf-opt-row">
          <%= text_field_tag "question[options_text][]", nil, class: "qf-input", placeholder: "Вариант #{i + 1}", "aria-label": "Вариант #{i + 1}" %>
          <label class="qf-check">
            <%= check_box_tag "question[options_correct][]", i %> верный
          </label>
        </div>
      <% end %>
      <p class="qf-hint">От 2 до 6 вариантов, пустые строки отбрасываются. Для одиночного выбора отметьте ровно один.</p>
    </fieldset>

    <%= f.label :deadline, "Дедлайн", class: "qf-label" %>
    <%= f.datetime_field :deadline, required: true, class: "qf-input" %>

    <%= label_tag "question[tags_string]", "Теги через запятую", class: "qf-label" %>
    <%= text_field_tag "question[tags_string]", nil, class: "qf-input", placeholder: "программирование, среднее" %>

    <div id="qf-reference-wrap">
      <%= f.label :reference_answer, "Правильный ответ (откроется после дедлайна)", class: "qf-label" %>
      <%= f.text_area :reference_answer, rows: 4, class: "qf-input" %>
    </div>

    <%= f.label :explanation, "Объяснение ответа (необязательно, откроется после дедлайна)", class: "qf-label" %>
    <%= f.text_area :explanation, rows: 3, class: "qf-input", placeholder: "Почему так — разбор, подсказки…" %>

    <div class="qf-actions">
      <button type="submit" class="qf-apply">Опубликовать</button>
    </div>
  <% end %>

  <script>
    const qfType = document.getElementById("question_answer_type");
    const qfOpts = document.getElementById("qf-options");
    const qfRef = document.getElementById("qf-reference-wrap");
    const qfSync = () => { const choice = qfType.value === "single_choice" || qfType.value === "multiple_choice"; qfOpts.hidden = !choice; qfRef.hidden = choice; };
    qfType.addEventListener("change", qfSync); qfSync();
  </script>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span>Новый вопрос</span>
  </footer>
</main>
