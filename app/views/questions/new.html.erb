<% content_for :title, "Новый вопрос" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: "mine" %>

<main class="qf-main">
  <% if @in_test %>
    <%= link_to "← К тесту", edit_test_path(@test_scope), class: "qf-back" %>
  <% end %>
  <p class="qf-kicker">Публикация<%= " · вопрос теста «#{@test_scope.title}»" if @in_test %></p>
  <h1 class="qf-hero">Новый вопрос</h1>

  <%= render "form", question: @question, submit_label: "Опубликовать", can_manage_trustees: true, in_test: @in_test %>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span>Новый вопрос</span>
  </footer>
</main>
