<% content_for :title, "Архив — QuizForum" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: nil %>

<main class="qf-main qf-main-home">
  <% pager = @pagers[:page] %>
  <%= link_to "← К открытым вопросам", root_path, class: "qf-back" %>
  <p class="qf-kicker">Архив · <%= pager[:count] %></p>
  <h1 class="qf-hero">Архив</h1>

  <% if AiQuestions.enabled? %>
    <nav class="qf-tabs" aria-label="Архивные рубрики">
      <%= link_to "Все", archive_path(ai: "all"), class: "qf-pager-step", aria: { current: @ai_filter == "all" } %>
      <%= link_to "Без ИИ", archive_path(ai: "0"), class: "qf-pager-step", aria: { current: @ai_filter == "0" } %>
      <%= link_to "Только ИИ", archive_path(ai: "1"), class: "qf-pager-step", aria: { current: @ai_filter == "1" } %>
    </nav>
  <% end %>

  <%= render "shared/filters", url: @ai_filter == "0" ? archive_path : archive_path(ai: @ai_filter) %>

  <section class="qf-cards" aria-label="Архив вопросов">
    <% if @questions.empty? %>
      <p class="qf-empty"><%= filters_active? ? "Ничего не найдено. Попробуйте смягчить фильтры." : "В архиве пока пусто." %></p>
    <% end %>
    <% @questions.each_with_index do |question, i| %>
      <%= link_to question_path(question), class: "qf-card-link" do %>
        <article class="qf-card">
          <div class="qf-card-top">
            <span class="qf-card-num"><%= format("%02d", i + 1) %></span>
            <span class="qf-card-tags"><%= question.tags.map { "##{it}" }.join(" ") %></span>
            <span class="qf-card-attempts">ответили: <%= question.attempts.size %></span>
          </div>
          <h2 class="qf-card-title"><%= question_title_with_date(question) %></h2>
          <div class="qf-card-meta">
            <span class="qf-card-author"><%= question.author.name %><%= " • #{question.author.display_role}" if question.author.display_role.present? %></span>
            <span class="qf-chip">закрыт <%= local_time_tag(question.deadline) %></span>
          </div>
        </article>
      <% end %>
    <% end %>
  </section>

  <%= render "shared/pager", pager: pager %>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span><%= pager[:count] %> вопросов в архиве</span>
  </footer>
</main>
