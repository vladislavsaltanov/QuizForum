<% content_for :title, "Вход" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<main class="qf-main qf-auth">
  <p class="qf-kicker">QuizForum</p>
  <h1 class="qf-hero">Вход</h1>

  <%= form_with url: session_path, class: "qf-form" do |form| %>
    <%= form.label :email, "Почта", class: "qf-label" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", class: "qf-input", value: params[:email] %>
    <%= form.label :password, "Пароль", class: "qf-label" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", class: "qf-input", maxlength: 72 %>
    <button type="submit" class="qf-apply qf-wide">Войти</button>
  <% end %>

  <div class="qf-auth-links">
    <%= link_to "Забыли пароль?", new_password_path %>
    <%= link_to "Нет аккаунта? Зарегистрироваться", new_registration_path %>
  </div>

  <p class="qf-or"><span>или</span></p>
  <%= button_to "Продолжить через Google", "/auth/google_oauth2", data: { turbo: false }, class: "qf-ghost qf-wide" %>
</main>
