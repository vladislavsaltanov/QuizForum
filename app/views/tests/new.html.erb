<% content_for :title, "Новый тест" %>

<%= render "shared/header", active: nil %>

<main class="qf-main">
  <p class="qf-kicker">Публикация</p>
  <h1 class="qf-hero">Новый тест</h1>

  <%= form_with model: @test, url: tests_path, class: "qf-form" do |f| %>
    <% if @test.errors.any? %>
      <div class="qf-alert" role="alert"><%= @test.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= f.label :title, "Название", class: "qf-label" %>
    <%= f.text_field :title, required: true, class: "qf-input", placeholder: "О чём тест?" %>

    <%= f.label :body, "Описание", class: "qf-label" %>
    <%= f.text_area :body, rows: 3, class: "qf-input", placeholder: "О чём этот тест…" %>

    <%= f.label :deadline, "Дедлайн", class: "qf-label" %>
    <%= f.datetime_field :deadline, required: true, class: "qf-input" %>

    <%= f.label :password, "Пароль (пусто = открытый тест)", class: "qf-label" %>
    <%= f.password_field :password, class: "qf-input", autocomplete: "off" %>

    <%= f.label :max_points, "Максимум баллов (пусто = сумма баллов заданий)", class: "qf-label" %>
    <%= f.number_field :max_points, min: 1, class: "qf-input", placeholder: "например, 10" %>

    <h2 class="qf-section-title">Задания</h2>
    <p class="qf-hint">Пустые задания отбрасываются. Варианты — по одному на строку, верный пометьте * в начале.</p>
    <% @task_rows.each_with_index do |row, i| %>
      <fieldset class="qf-card">
        <legend class="qf-label">Задание <%= i + 1 %></legend>
        <%= text_area_tag "tasks_body[]", row["body"], rows: 3, class: "qf-input", placeholder: "Текст задания…", "aria-label": "Текст задания #{i + 1}" %>
        <div class="qf-opt-row">
          <%= select_tag "tasks_answer_type[]", options_for_select([ [ "Свободный текст", "text" ], [ "Один вариант", "single_choice" ], [ "Несколько вариантов", "multiple_choice" ] ], row["answer_type"] || "text"), class: "qf-input", "aria-label": "Тип задания #{i + 1}" %>
          <%= number_field_tag "tasks_points[]", row["points"] || 1, min: 0, max: 100, class: "qf-input", "aria-label": "Баллы за задание #{i + 1}" %>
        </div>
        <%= text_area_tag "tasks_options[]", row["options"], rows: 3, class: "qf-input", placeholder: "Варианты (только для типов с выбором)…", "aria-label": "Варианты задания #{i + 1}" %>
      </fieldset>
    <% end %>

    <div class="qf-actions">
      <button type="submit" class="qf-apply" data-turbo-submits-with="Отправка…">Опубликовать</button>
    </div>
  <% end %>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span>Новый тест</span>
  </footer>
</main>
