<% content_for :title, "Новый тест" %>

<%= render "shared/header", active: "tests" %>

<main class="qf-main" data-controller="test-form">
  <p class="qf-kicker">Публикация</p>
  <h1 class="qf-hero">Новый тест</h1>

  <%= form_with model: @test, url: tests_path, class: "qf-form" do |f| %>
    <% if @test.errors.any? %>
      <div class="qf-alert" role="alert"><%= @test.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= f.label :title, "Название", class: "qf-label" %>
    <%= f.text_field :title, required: true, class: "qf-input", placeholder: "О чём тест?" %>

    <%= f.label :body, "Описание", class: "qf-label" %>
    <%= f.text_area :body, rows: 3, class: "qf-input", placeholder: "О чём этот тест…" %>

    <%= f.label :deadline, "Дедлайн", class: "qf-label" %>
    <%= f.datetime_field :deadline, required: true, class: "qf-input" %>

    <%= f.label :password, "Пароль (пусто = открытый тест)", class: "qf-label" %>
    <%= f.password_field :password, class: "qf-input", autocomplete: "off" %>

    <%= f.label :max_points, "Максимум баллов (пусто = сумма баллов вопросов)", class: "qf-label" %>
    <%= f.number_field :max_points, min: 1, class: "qf-input", placeholder: "например, 10" %>

    <h2 class="qf-section-title">Вопросы теста</h2>
    <p class="qf-hint">Добавляйте вопросы кнопкой ниже — каждый со своими баллами. Пустые отбрасываются. Правильный ответ нужен для текста и кода; варианты — по одному на строку, верный пометьте * в начале. Тест публикуется вместе со всеми вопросами, одним нажатием.</p>

    <div data-test-form-target="list">
      <% @question_rows.each do |row| %>
        <%= render "question_block", row: row %>
      <% end %>
    </div>

    <template data-test-form-target="template">
      <%= render "question_block", row: {} %>
    </template>

    <div class="qf-actions">
      <button type="button" class="qf-ghost" data-test-form-target="add" data-action="click->test-form#add">Добавить вопрос</button>
    </div>

    <div class="qf-actions">
      <button type="submit" class="qf-apply" data-turbo-submits-with="Отправка…">Опубликовать тест</button>
    </div>
  <% end %>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span>Новый тест</span>
  </footer>
</main>
