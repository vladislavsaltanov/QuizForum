<% content_for :title, "Мои тесты" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: "tests" %>

<main class="qf-main">
  <% @in_work = @authored.select(&:draft?) + @authored.select { it.published? && it.open? } %>
  <% @finished = @authored.select { it.published? && it.closed? } %>

  <p class="qf-kicker">Всего · <%= @authored.size + @taken.size %></p>
  <h1 class="qf-hero">Мои тесты</h1>

  <div class="qf-list-top">
    <%= link_to "+ Новый тест", new_test_path, class: "qf-apply" %>
  </div>

  <section class="qf-cards" aria-label="В работе">
    <% if @in_work.empty? %>
      <p class="qf-empty">Пока нет ваших тестов — создайте первый кнопкой выше.</p>
    <% end %>
    <% @in_work.each_with_index do |test, i| %>
      <%= render "tests/test_card", test: test, num: i + 1 %>
    <% end %>
  </section>

  <% unless @finished.empty? %>
    <hr class="qf-divider">
    <h2 class="qf-section-title">Завершённые</h2>
    <section class="qf-cards" aria-label="Завершённые">
      <% @finished.each_with_index do |test, i| %>
        <%= render "tests/test_card", test: test, num: i + 1 %>
      <% end %>
    </section>
  <% end %>

  <h2 class="qf-section-title">Пройдено мной</h2>
  <section class="qf-cards" aria-label="Пройдено мной">
    <% if @taken.empty? %>
      <p class="qf-empty">Вы пока не проходили тесты. Открытые тесты ищите на <%= link_to "главном экране", root_path %>.</p>
    <% end %>
    <% @taken.each_with_index do |test, i| %>
      <% score = test.closed? ? test.total_score(Current.user) : nil %>
      <%= render "tests/test_card", test: test, num: i + 1, taken: true, my_score: score %>
    <% end %>
  </section>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span><%= plural_ru(@authored.size + @taken.size, "тест", "теста", "тестов") %></span>
  </footer>
</main>
