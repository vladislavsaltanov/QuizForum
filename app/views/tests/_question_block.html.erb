<%# One question block in the test creation list: title, body, type, points, %>
<%# reference, options. Params are parallel arrays; DOM order is the position. %>
<fieldset class="qf-card">
  <div class="qf-attempt-head">
    <b data-role="head">Вопрос</b>
    <label class="qf-chip">баллов:
      <%= number_field_tag "questions_points[]", row["points"] || 1, min: 0, max: 100, class: "qf-input", "aria-label": "Баллы за вопрос", data: { role: "label", base: "Баллы за вопрос" } %>
    </label>
  </div>
  <%= text_field_tag "questions_title[]", row["title"], class: "qf-input", placeholder: "Заголовок вопроса…", "aria-label": "Заголовок вопроса", data: { role: "label", base: "Заголовок вопроса" } %>
  <%= text_area_tag "questions_body[]", row["body"], rows: 2, class: "qf-input", placeholder: "Текст вопроса…", "aria-label": "Текст вопроса", data: { role: "label", base: "Текст вопроса" } %>
  <%= select_tag "questions_answer_type[]", options_for_select([ [ "Свободный текст", "text" ], [ "Код", "code" ], [ "Один вариант", "single_choice" ], [ "Несколько вариантов", "multiple_choice" ] ], row["answer_type"] || "text"), class: "qf-input", "aria-label": "Тип вопроса", data: { role: "label", base: "Тип вопроса" } %>
  <%= text_area_tag "questions_reference[]", row["reference"], rows: 2, class: "qf-input", placeholder: "Правильный ответ (текст/код)…", "aria-label": "Правильный ответ", data: { role: "label", base: "Правильный ответ" } %>
  <%= text_area_tag "questions_options[]", row["options"], rows: 3, class: "qf-input", placeholder: "Варианты (только для типов с выбором)…", "aria-label": "Варианты вопроса", data: { role: "label", base: "Варианты вопроса" } %>
  <div class="qf-actions">
    <button type="button" class="qf-ghost" data-action="click->test-form#remove">Убрать вопрос</button>
  </div>
</fieldset>
