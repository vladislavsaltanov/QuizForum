<% content_for :title, @test.title %>

<%= render "shared/header", active: "tests" %>

<%# Top flow mirrors the question page: back → kicker → title → author
    plate; the manage button rides the plate row instead of crowding the kicker. %>
<main class="qf-main qf-main-wide">
  <%= link_to "← Все тесты", tests_path, class: "qf-back" %>
  <p class="qf-kicker">
    <% if @test.draft? %>
      Черновик · не опубликован
    <% elsif @test.open? %>
      До дедлайна · <%= time_left(@test.deadline) %>
    <% else %>
      Завершён <%= local_time_tag(@test.deadline) %>
    <% end %>
  </p>
  <h1 class="qf-qtitle"><%= @test.title %></h1>
  <% if @test.published? %>
    <%# Author plate, same voice and pieces as the question page. %>
    <div class="qf-card qf-author-card">
      <%= avatar_tag(@test.author.name) %>
      <span class="qf-author-meta">
        <b><%= @test.author.name %></b>
        <% if @test.author.display_role.present? %>
          <i><%= @test.author.display_role %></i>
        <% end %>
      </span>
      <span class="qf-card-attempts">ответили: <%= @respondents %></span>
      <% if @test.editable_by?(Current.user) %>
        <%= link_to "Настроить тест", edit_test_path(@test), class: "qf-ghost" %>
      <% end %>
    </div>
  <% elsif @test.editable_by?(Current.user) %>
    <div class="qf-actions">
      <%= link_to "Продолжить создание", edit_test_path(@test), class: "qf-ghost" %>
    </div>
  <% end %>
  <% if @test.body.present? %>
    <div class="qf-body"><%= simple_format(@test.body) %></div>
  <% end %>

  <% if @test.draft? %>
    <%# Draft: question titles only, no answering yet. %>
    <% @questions.each_with_index do |question, i| %>
      <section class="qf-card" aria-label="Вопрос <%= i + 1 %>">
        <div class="qf-attempt-head">
          <b>Вопрос <%= i + 1 %> из <%= @questions.size %></b>
          <span class="qf-chip">баллов: <%= question.points %></span>
        </div>
        <h2 class="qf-section-title"><%= question.title %></h2>
      </section>
    <% end %>
  <% elsif @is_author %>
    <p class="qf-hint">Это ваш тест — знать ответы заранее и отвечать нельзя. Ждите результаты после дедлайна.</p>
    <% @questions.each_with_index do |question, i| %>
      <section class="qf-card" aria-label="Вопрос <%= i + 1 %>">
        <div class="qf-attempt-head">
          <b>Вопрос <%= i + 1 %> из <%= @questions.size %></b>
          <span class="qf-chip">баллов: <%= question.points %></span>
        </div>
        <h2 class="qf-section-title"><%= question.title %></h2>
        <div class="qf-body"><%= simple_format(question.body) %></div>
      </section>
    <% end %>
  <% else %>
    <% if @answered %>
      <p class="qf-hint">Попытка записана, изменить её нельзя.</p>
    <% end %>

    <% if @answered || !@test.open? %>
      <%# Read-only: own answers, verdicts only after the deadline. %>
      <% @questions.each_with_index do |question, i| %>
        <% attempt = @my_attempts[question.id] %>
        <section class="qf-card" aria-label="Вопрос <%= i + 1 %>">
          <div class="qf-attempt-head">
            <b>Вопрос <%= i + 1 %> из <%= @questions.size %></b>
            <span class="qf-chip">баллов: <%= question.points %></span>
            <% if @test.closed? && attempt %>
              <span class="qf-chip <%= verdict_class(attempt.verdict) %>"><%= verdict_label(attempt.verdict) %></span>
            <% end %>
          </div>
          <h2 class="qf-section-title"><%= question.title %></h2>
          <div class="qf-body"><%= simple_format(question.body) %></div>
          <% if attempt %>
            <% if @test.closed? %>
              <% if question.choice? %>
                <div class="qf-body"><%= Array(attempt.selected).map { |s| question.options[s.to_i]&.dig("text") }.compact.join("; ") %></div>
              <% else %>
                <div class="qf-body"><%= simple_format(attempt.body) %></div>
              <% end %>
            <% else %>
              <span class="qf-chip"><%= verdict_label("pending") %></span>
            <% end %>
          <% end %>
        </section>
      <% end %>
    <% elsif @test.open? %>
      <%# One form, one submit: the whole test is a single indivisible attempt,
          presented as a step wizard (steps stay visible without JS);
          typed answers ride back on the 422 re-render to keep the input. %>
      <% typed = @form_answers || {} %>
      <% if @questions.size > 1 %>
        <nav class="qf-wizard-progress" aria-label="Прогресс вопросов">
          <% @questions.each_with_index do |_, i| %>
            <button type="button" class="qf-wizard-dot<%= " is-active" if i.zero? %>" data-goto="<%= i %>" aria-label="Вопрос <%= i + 1 %>"></button>
          <% end %>
          <span class="qf-wizard-count">шаг 1 из <%= @questions.size %></span>
        </nav>
      <% end %>
      <%= form_with url: attempt_test_path(@test), class: "qf-form", data: { wizard: "1", turbo_frame: "_top" } do %>
        <% @questions.each_with_index do |question, i| %>
          <section class="qf-card qf-step" data-step="<%= i %>" aria-label="Вопрос <%= i + 1 %>">
            <div class="qf-attempt-head">
              <b>Вопрос <%= i + 1 %> из <%= @questions.size %></b>
              <span class="qf-chip">баллов: <%= question.points %></span>
            </div>
            <h2 class="qf-section-title"><%= question.title %></h2>
            <div class="qf-body"><%= simple_format(question.body) %></div>
            <% saved = typed[question.id.to_s].is_a?(Hash) ? typed[question.id.to_s] : {} %>
            <% case question.answer_type %>
            <% when "text" %>
              <%= text_area_tag "answers[#{question.id}][body]", saved["body"], rows: 6, placeholder: "Ваш ответ…", class: "qf-input qf-answer-area", "aria-label": "Ответ на вопрос #{i + 1}" %>
            <% when "code" %>
              <% allowed = question.code_languages.presence || CodeRunnerClient::SUPPORTED_LANGUAGES %>
              <%= select_tag "answers[#{question.id}][language]", options_for_select(allowed, saved["language"]), class: "qf-input", "aria-label": "Язык вопроса #{i + 1}" %>
              <%= text_area_tag "answers[#{question.id}][body]", saved["body"], rows: 8, placeholder: "Ваш код…", class: "qf-input qf-code qf-answer-area", "aria-label": "Код на вопрос #{i + 1}" %>
            <% when "single_choice" %>
              <% picked = Array(saved["selected"]).map(&:to_s) %>
              <% question.options.each_with_index do |opt, oi| %>
                <label class="qf-option">
                  <%# no required: attribute — once JS hides a step, a required
                      field there blocks the submit with a native error;
                      validation stays in the model instead. %>
                  <%= radio_button_tag "answers[#{question.id}][selected][]", oi, picked.include?(oi.to_s) %>
                  <span><%= opt["text"] %></span>
                </label>
              <% end %>
            <% when "multiple_choice" %>
              <% picked = Array(saved["selected"]).map(&:to_s) %>
              <% question.options.each_with_index do |opt, oi| %>
                <label class="qf-option">
                  <%= check_box_tag "answers[#{question.id}][selected][]", oi, picked.include?(oi.to_s) %>
                  <span><%= opt["text"] %></span>
                </label>
              <% end %>
            <% end %>
          </section>
        <% end %>
        <div class="qf-wizard-bar">
          <span class="qf-wizard-done">отвечено 0 из <%= @questions.size %></span>
          <button type="submit" class="qf-apply">Отправить все ответы</button>
        </div>
      <% end %>
      <%# Wizard step engine, same end-of-main inline pattern as the chat
          tail-follow. Markup ships every step visible; the script adds
          .qf-wizard-on FIRST, so CSS hides steps only when JS is present.
          Dot jumps skip validation on purpose: dots are shortcuts, the
          submit button final-validates (fields + server-side checks). %>
      <script>
        {
          const form = document.querySelector('form[data-wizard="1"]');
          if (form && !form.classList.contains("qf-wizard-on")) {
            const steps = [...form.querySelectorAll(".qf-step")];
            const dots = [...document.querySelectorAll(".qf-wizard-dot[data-goto]")];
            const count = document.querySelector(".qf-wizard-count");
            const done = document.querySelector(".qf-wizard-done");
            const M = steps.length;
            form.classList.add("qf-wizard-on");

            const emptyField = (step) => {
              for (const area of step.querySelectorAll("textarea")) if (!area.value.trim()) return area;
              // single_choice and multiple_choice both need one checkbox ticked,
              // mirroring the model-level answer_present check.
              const boxes = [...step.querySelectorAll("input[type='radio'], input[type='checkbox']")];
              if (boxes.length && !boxes.some((b) => b.checked)) return boxes[0];
              return null;
            };
            const stepDone = (step) => emptyField(step) === null;
            const recount = () => {
              done.textContent = `отвечено ${steps.filter(stepDone).length} из ${M}`;
            };

            // Далее/Назад and the hint are JS-built so a no-JS page never shows them.
            steps.forEach((step, i) => {
              if (i > 0) {
                const prev = document.createElement("button");
                prev.type = "button";
                prev.className = "qf-ghost qf-wizard-prev";
                prev.textContent = "Назад";
                prev.addEventListener("click", () => show(i - 1));
                step.append(prev);
              }
              if (i < M - 1) {
                const next = document.createElement("button");
                next.type = "button";
                next.className = "qf-apply qf-wizard-next";
                next.textContent = "Далее";
                next.addEventListener("click", () => {
                  const bad = emptyField(step);
                  if (bad) {
                    step.querySelector(".qf-step-hint").classList.add("is-visible");
                    bad.focus();
                  } else show(i + 1);
                });
                step.append(next);
              }
              const hint = document.createElement("p");
              hint.className = "qf-step-hint";
              hint.textContent = "Заполните ответ, чтобы продолжить";
              step.append(hint);
            });

            function show(i) {
              steps.forEach((s, k) => s.classList.toggle("is-active", k === i));
              dots.forEach((d) => d.classList.toggle("is-active", d.dataset.goto === String(i)));
              if (count) count.textContent = `шаг ${i + 1} из ${M}`;
              form.querySelectorAll(".qf-step-hint.is-visible").forEach((h) => h.classList.remove("is-visible"));
            }

            dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.goto))));
            form.addEventListener("input", recount);
            form.addEventListener("change", recount);
            recount();
            // After a 422 re-render with restored answers, start on the first
            // incomplete step; otherwise that is step 1.
            show(Math.max(0, steps.findIndex((s) => !stepDone(s))));

            // Turbo keeps a snapshot: strip JS-built state so a cache restore
            // (scripts do not re-run) falls back to the visible stacked form.
            document.addEventListener("turbo:before-cache", () => {
              form.classList.remove("qf-wizard-on");
              steps.forEach((s) => s.classList.remove("is-active"));
              form.querySelectorAll(".qf-wizard-prev, .qf-wizard-next, .qf-step-hint")
                .forEach((n) => n.remove());
            });
          }
        }
      </script>    <% end %>
  <% end %>

  <% if @test.closed? && @test.published? %>
    <% if @my_attempts.any? %>
      <h2 class="qf-section-title">Ваш результат</h2>
      <p class="qf-count"><%= @test.total_score(Current.user) %> из <%= @test.max_score %></p>
    <% end %>
    <h2 class="qf-section-title">Результаты</h2>
    <% if @scoreboard.empty? %>
      <p class="qf-empty">Пока никто не отвечал.</p>
    <% else %>
      <% @scoreboard.each do |user, total| %>
        <div class="qf-card">
          <div class="qf-attempt-head">
            <span><%= avatar_tag(user.name, size: :sm) %><%= user.name %></span>
            <span class="qf-chip"><%= total %> из <%= @test.max_score %></span>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# Comment chat: same premoderation as questions; the test author approves, %>
  <%# the Deadline opens everything. Live stream mirrors the question page. %>
  <% if @test.published? %>
    <%= turbo_stream_from @test %>
    <% if @test.privileged?(Current.user) %>
      <%= turbo_stream_from @test, "manage" %>
    <% end %>
    <hr class="qf-divider">
    <section class="qf-test-discuss is-comments" aria-label="Обсуждение">
      <div class="qf-list-head">
        <p class="qf-count">Обсуждение · <span id="test-comments-count"><%= @comments.size %></span></p>
      </div>
      <%= render "comments/chat", comments: @comments, post_path: test_comments_path(@test), form_id: "test-chatbar" %>
    </section>
  <% end %>

  <%# Fixed-height chat: tail-follow to the newest message, composer stays put. %>
  <% if @test.published? %>
    <script>
      {
        const qfTestChat = document.getElementById("comments");
        if (qfTestChat) {
          qfTestChat.scrollTop = qfTestChat.scrollHeight;
          new MutationObserver(() => { qfTestChat.scrollTop = qfTestChat.scrollHeight; })
            .observe(qfTestChat, { childList: true });
        }
      }
    </script>
  <% end %>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span><%= @test.draft? ? "Черновик" : (@test.open? ? "Открыт" : "Завершён") %></span>
  </footer>
</main>
