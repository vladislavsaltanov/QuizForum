<header class="qf-header">
  <span class="qf-logo">QuizForum</span>
  <nav class="qf-nav" aria-label="Основная навигация">
    <% if local_assigns[:active] == "main" %>
      <span class="qf-nav-item is-active" aria-current="page">Главный экран</span>
    <% else %>
      <%= link_to "Главный экран", root_path, class: "qf-nav-item qf-nav-link" %>
    <% end %>
    <% if local_assigns[:active] == "mine" %>
      <span class="qf-nav-item is-active" aria-current="page">Мои вопросы</span>
    <% else %>
      <%= link_to "Мои вопросы", my_questions_path, class: "qf-nav-item qf-nav-link" %>
    <% end %>
    <% if local_assigns[:active] == "leaders" %>
      <span class="qf-nav-item is-active" aria-current="page">Таблица лидеров</span>
    <% else %>
      <%= link_to "Таблица лидеров", leaderboard_path, class: "qf-nav-item qf-nav-link" %>
    <% end %>
    <% if local_assigns[:active] == "profile" %>
      <span class="qf-nav-item is-active" aria-current="page">Профиль</span>
    <% else %>
      <%= link_to "Профиль", profile_path, class: "qf-nav-item qf-nav-link" %>
    <% end %>
  </nav>
  <div class="qf-user">
    <span class="qf-user-email"><%= Current.user.email %></span>
    <%= button_to "Выйти", session_path, method: :delete, class: "qf-signout" %>
  </div>
</header>
