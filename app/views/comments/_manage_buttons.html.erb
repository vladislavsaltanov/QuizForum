<%# The privileged controls for one comment; swapped into its manage slot. %>
<div class="qf-manage-buttons">
  <% if !comment.approved? %>
    <%= button_to "Опубликовать", approve_test_comment_path(comment.test, comment),
          method: :patch, class: "qf-ghost" %>
  <% end %>
  <%= button_to "Удалить", test_comment_path(comment.test, comment),
        method: :delete, class: "qf-ghost" %>
</div>
