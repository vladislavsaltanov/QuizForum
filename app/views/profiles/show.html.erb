<% content_for :title, "Профиль" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: "profile" %>

<main class="qf-main">
  <p class="qf-kicker">Профиль</p>
  <h1 class="qf-hero"><%= @user.name %></h1>

  <div class="qf-card qf-id-card">
    <span class="qf-avatar qf-avatar-xl" aria-hidden="true"><%= initials(@user.name) %></span>
    <span class="qf-author-meta">
      <b><%= @user.display_role.presence || "Участник" %></b>
      <i>ID <%= @user.id %> · <%= @user.email %> · на сайте с <%= local_time_tag(@user.created_at, date_only: true) %></i>
    </span>
    <span class="qf-chip"><%= @rank ? "##{@rank} в рейтинге" : "#- вне таблицы" %></span>
  </div>

  <h2 class="qf-section-title">Статистика</h2>
  <div class="qf-stats">
    <div class="qf-stat"><span>Опубликовано вопросов</span><b><%= @published %></b></div>
    <div class="qf-stat"><span>Дано ответов</span><b><%= @answered %></b></div>
    <div class="qf-stat"><span>Верных ответов</span><b class="<%= verdict_class("correct") %>"><%= @score %></b></div>
  </div>

  <div class="qf-actions">
    <%= link_to "Редактировать", edit_profile_path, class: "qf-ghost" %>
    <%= link_to "Мои вопросы", my_questions_path, class: "qf-ghost" %>
    <%= link_to "Таблица лидеров", leaderboard_path, class: "qf-ghost" %>
  </div>

  <% if Current.user.admin? %>
    <h2 class="qf-section-title">Администрирование</h2>
    <%= form_with url: grant_role_profile_path, method: :patch, class: "qf-form" do %>
      <%= label_tag "user_id", "ID пользователя", class: "qf-label" %>
      <%= number_field_tag "user_id", nil, required: true, min: 1, class: "qf-input" %>
      <%= label_tag "display_role", "Роль (пусто — снять роль)", class: "qf-label" %>
      <%= text_field_tag "display_role", nil, maxlength: 50, class: "qf-input", placeholder: "доцент кафедры" %>
      <div class="qf-actions">
        <button type="submit" class="qf-apply">Выдать роль</button>
      </div>
    <% end %>
  <% end %>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span>Профиль</span>
  </footer>
</main>
