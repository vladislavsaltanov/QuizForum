<% content_for :title, "QuizForum — главный экран" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: "main" %>

<main class="qf-main qf-main-home">
  <% pager = @pagers[:page] %>
  <p class="qf-kicker"><%= @date_filter_active ? "Вопросы по дате" : "Открытые вопросы" %> · <%= pager[:count] %></p>
  <h1 class="qf-hero">Вопросы</h1>

  <%= render "shared/filters", url: root_path %>

  <%= render "ai_banner" if @ai_pack.any? %>

  <section class="qf-cards" aria-label="Вопросы">
    <% if @questions.empty? %>
      <p class="qf-empty">Ничего не найдено. Попробуйте смягчить фильтры.</p>
    <% end %>
    <% @questions.each_with_index do |question, i| %>
      <%= link_to question_path(question), class: "qf-card-link" do %>
        <article class="qf-card">
          <div class="qf-card-top">
            <span class="qf-card-num"><%= format("%02d", i + 1) %></span>
            <span class="qf-card-tags"><%= question.tags.map { "##{it}" }.join(" ") %></span>
            <span class="qf-card-attempts">ответили: <%= question.attempts.size %></span>
          </div>
          <h2 class="qf-card-title"><%= question_title_with_date(question) %></h2>
          <div class="qf-card-meta">
            <span class="qf-card-author"><%= question.author.name %><%= " • #{question.author.display_role}" if question.author.display_role.present? %></span>
            <% if question.closed? %>
              <span class="qf-chip">закрыт <%= local_time_tag(question.deadline) %></span>
            <% elsif question.closing_soon? %>
              <span class="qf-chip qf-chip-urgent">заканчивается · <%= time_left(question.deadline) %></span>
            <% else %>
              <span class="qf-chip">до <%= local_time_tag(question.deadline) %></span>
            <% end %>
          </div>
        </article>
      <% end %>
    <% end %>
  </section>

  <%= render "shared/pager", pager: pager %>

  <%# Same pill as the page-switch buttons above it, so the archive reads as part of
      the same navigation. One COUNT for the whole page, never inside the card loop. %>
  <% archived_count = Question.archived.count %>
  <nav class="qf-pager" aria-label="Архив вопросов">
    <%= link_to "Архив · #{archived_count}", archive_path, class: "qf-pager-step" %>
  </nav>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span><%= @date_filter_active ? "#{pager[:count]} вопросов по дате" : "#{pager[:count]} открытых вопросов" %></span>
  </footer>
</main>
