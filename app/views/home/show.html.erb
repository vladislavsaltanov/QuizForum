<% content_for :title, "QuizForum — главный экран" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<% end %>

<%= render "shared/header", active: "main" %>

<main class="qf-main qf-main-home">
  <% pager = @pagers[:page] %>
  <p class="qf-kicker"><%= @date_filter_active ? "Вопросы по дате" : "Вопросы" %> · <%= pager[:count] %></p>
  <h1 class="qf-hero">Вопросы</h1>

  <%= render "shared/filters", url: root_path %>


  <%= render "ai_banner" if @ai_pack.any? %>

  <% if @feed_tests.any? %>
    <%# Own spacing wrapper: without it the question feed glues to the test cards. %>
    <div class="qf-home-tests">
      <h2 class="qf-section-title">Открытые тесты · <%= @feed_tests.size %></h2>
      <section class="qf-cards" aria-label="Открытые тесты">
        <% @feed_tests.each_with_index do |test, i| %>
          <%# Belt and braces: home_feed already filters, but never render a
              protected or draft test if data ever sneaks in. %>
          <% next if test.protected? || test.draft? %>
          <%= render "tests/test_card", test: test, num: i + 1, my_state: @my_test_state[test.id] %>
        <% end %>
      </section>
    </div>
  <% end %>

  <%# The feed splits into named groups so it reads like the test block above:
      open first, the seven-day closed tail after. Empty groups collapse away. %>
  <% open_questions = @questions.select(&:open?) %>
  <% closed_tail = @questions.select(&:closed?) %>
  <% if @questions.empty? %>
    <p class="qf-empty">Ничего не найдено. Попробуйте смягчить фильтры.</p>
  <% end %>
  <% if open_questions.any? %>
    <h2 class="qf-section-title">Открытые вопросы · <%= open_questions.size %></h2>
    <section class="qf-cards" aria-label="Открытые вопросы">
      <% open_questions.each_with_index do |question, i| %>
        <%= render "home/question_card", question: question, i: i %>
      <% end %>
    </section>
  <% end %>
  <% if closed_tail.any? %>
    <h2 class="qf-section-title qf-closed-tail-title">Недавно закрытые вопросы · <%= closed_tail.size %></h2>
    <section class="qf-cards" aria-label="Недавно закрытые вопросы">
      <% closed_tail.each_with_index do |question, i| %>
        <%= render "home/question_card", question: question, i: i %>
      <% end %>
    </section>
  <% end %>

  <%= render "shared/pager", pager: pager %>

  <%# Same pill as the page-switch buttons above it, so the archive reads as part of
      the same navigation. One COUNT for the whole page, never inside the card loop. %>
  <% archived_count = Question.archived.count %>
  <nav class="qf-pager" aria-label="Архив вопросов">
    <%= link_to "Архив · #{archived_count}", archive_path, class: "qf-pager-step" %>
  </nav>

  <footer class="qf-footer">
    <span>QuizForum</span>
    <span><%= @date_filter_active ? "#{pager[:count]} вопросов по дате" : "#{pager[:count]} открытых вопросов" %></span>
  </footer>
</main>
