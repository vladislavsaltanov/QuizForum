<%# «Мои тесты» strip on home: compact rows, not the dashboard cards.
    Drafts-first order comes from the controller. %>
<nav class="qf-my-strip" aria-label="Мои тесты">
  <p class="qf-kicker">Мои тесты · <%= @my_tests.size %> <%= link_to "все мои тесты →", tests_path, class: "qf-strip-more" %></p>
  <ul class="qf-strip-rows">
    <% @my_tests.each do |test| %>
      <li>
        <%= link_to test.draft? ? edit_test_path(test) : test_path(test), class: "qf-strip-row" do %>
          <span class="qf-strip-title"><%= test.title %></span>
          <% if test.draft? %>
            <span class="qf-chip">черновик</span>
          <% elsif test.closed? %>
            <span class="qf-chip">завершён</span>
          <% else %>
            <span class="qf-chip">до <%= local_time_tag(test.deadline) %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
