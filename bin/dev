#!/bin/sh
# One command: real Laya sidecar (:8000) + coderunner (:8001) + Rails. External services win when set.
set -u
cd "$(dirname "$0")/.."

if [ "${LAYA_SIDECAR_URL:-}" = "" ]; then
  if [ ! -x sidecar/.venv/bin/python ]; then
    PYBIN="$(command -v python3.12 || command -v python3)"
    if [ -z "$PYBIN" ]; then
      echo "python3.12 or python3 required for the sidecar" >&2
      exit 1
    fi
    "$PYBIN" -m venv sidecar/.venv
  fi
  # First boot (and upgrades): laya present before the server starts.
  if ! sidecar/.venv/bin/pip install -q laya; then
    echo "cannot install laya into sidecar/.venv; check network and Python>=3.10" >&2
    exit 1
  fi
  # Jury weights (~1.6GB pinned revision) live in ./weights like Laya;
  # the sidecar downloads them itself on first boot.
  export HF_HOME="$PWD/weights/hf-cache"
  sidecar/.venv/bin/python sidecar/server.py 8000 >log/sidecar.log 2>&1 &
  SIDECAR_PID=$!
  export LAYA_SIDECAR_URL=http://localhost:8000
  # Readiness gate: first boot downloads weights into ./weights, can take minutes
  # (Laya + OpenJev 0.8B, CPU load). /up answers only when both are loaded.
  for _ in $(seq 1 180); do
    curl -sf -o /dev/null http://localhost:8000/up && break
    sleep 5
  done
  curl -sf -o /dev/null http://localhost:8000/up || {
    echo "sidecar not ready, see log/sidecar.log" >&2
    exit 1
  }
fi

if [ "${CODERUNNER_URL:-}" = "" ]; then
  CODERUNNER_PYBIN="$(command -v python3.12 || command -v python3)"
  if [ -z "$CODERUNNER_PYBIN" ]; then
    echo "python3.12 or python3 required for coderunner" >&2
    exit 1
  fi
  CODERUNNER_PORT="${CODERUNNER_PORT:-8001}"
  "$CODERUNNER_PYBIN" coderunner/server.py "$CODERUNNER_PORT" >log/coderunner.log 2>&1 &
  CODERUNNER_PID=$!
  export CODERUNNER_URL="http://localhost:${CODERUNNER_PORT}"
  # No model weights here: readiness is immediate, still gate it.
  for _ in $(seq 1 60); do
    curl -sf -o /dev/null "$CODERUNNER_URL/up" && break
    sleep 1
  done
  curl -sf -o /dev/null "$CODERUNNER_URL/up" || {
    echo "coderunner not ready, see log/coderunner.log" >&2
    exit 1
  }
  if curl -sf "$CODERUNNER_URL/up" | grep -q missing; then
    echo "warning: some coderunner runtimes missing (node/ruby); code checks for those languages stay pending" >&2
  fi
fi

trap 'kill ${SIDECAR_PID:-} ${CODERUNNER_PID:-} 2>/dev/null' EXIT INT TERM
rm -f tmp/pids/server.pid
./bin/rails server "$@"
STATUS=$?
kill ${SIDECAR_PID:-} ${CODERUNNER_PID:-} 2>/dev/null
exit $STATUS
