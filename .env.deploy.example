# QuizForum deploy secrets. On the server:
#   cp .env.deploy.example .env.deploy && nano .env.deploy
#   docker compose --env-file .env.deploy up -d --build
# Never commit .env.deploy.

# --- required ---
# Postgres password. Used by the db service and Rails DATABASE_URLs.
POSTGRES_PASSWORD=change-me-to-32-random-chars
# DB password Rails presents. Same value as above (single shared role).
QUIZ_FORUM_DATABASE_PASSWORD=change-me-to-32-random-chars
# From local config/master.key (never commit it either).
RAILS_MASTER_KEY=

# --- mail + links (registration needs SMTP) ---
APP_HOST=
SMTP_LOGIN=
GMAIL_APP_PASSWORD=

# --- Google OAuth (blank = password + email-confirmation login only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- plain HTTP vs auto-HTTPS ---
# Bare IP / no domain: leave both blank, FORCE_SSL=false.
# Own domain with DNS pointing at the server: set TLS_DOMAIN + FORCE_SSL=true,
# Thruster provisions Let's Encrypt and redirects HTTP to HTTPS.
TLS_DOMAIN=
FORCE_SSL=false
