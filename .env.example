GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
# Real Laya sidecar; blank = bin/dev starts the local sidecar on :8000.
LAYA_SIDECAR_URL=
# Emergency dev escape hatch only, never honored in production.
MODERATION_OFF=
# Public hostname for production (force_ssl hosts pin + mailer links). Blank = unset.
APP_HOST=

# --- AI question of the day (blank/disabled = human content only) ---
# Master kill switch: 0 hides AI packs and the archive AI tab, closes the webhook, skips jobs.
AI_QUESTIONS_ENABLED=1
# Zone the 17:00 create / 15:00 close cycle is counted in.
AI_TIME_ZONE=Europe/Moscow
# Webhook intake token (POST /api/ai_questions). Blank = endpoint closed.
AI_INGEST_TOKEN=
# Outgoing self-generation via AI Studio. Blank = no self-generation (webhook only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemma-4-31b-it
# Days an archived AI pack survives before deletion.
AI_RETENTION_DAYS=3
